# Environment Configuration
APP_ENV=development
DEBUG=False

# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8001/v1/spotify/callback

# YouTube API Credentials
# Get these from: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8002

# Database Configuration
DB_PATH=data/matched_tracks.db

# Logging Configuration
LOG_FILE_NAME=migration.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Track Matching Configuration
MATCH_FUZZ_THRESHOLD=70

# Cover Image Configuration
COVER_MIN_WIDTH=640
COVER_MIN_HEIGHT=480
COVER_ENHANCE_SIZE=640
HTTP_REQUEST_TIMEOUT=10

# Retry Configuration
SPOTIFY_RETRY_ATTEMPTS=3
SPOTIFY_RETRY_MULTIPLIER=1.0
SPOTIFY_RETRY_MAX=10

YOUTUBE_RETRY_ATTEMPTS=3
YOUTUBE_RETRY_MULTIPLIER=1.0
YOUTUBE_RETRY_MAX=10
