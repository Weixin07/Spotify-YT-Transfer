APP_ENV=development
DEBUG=False

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/v1/auth/spotify/callback

YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/auth/youtube/callback

DB_PATH=data/matched_tracks.db

TOKEN_STORAGE_USERNAME=spotify-yt-transfer
SPOTIFY_CACHE_PATH=.cache
YOUTUBE_TOKEN_PATH=token.pickle

LOG_FILE_NAME=migration.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

MATCH_FUZZ_THRESHOLD=69
HTTP_REQUEST_TIMEOUT=10

SPOTIFY_RETRY_ATTEMPTS=3
SPOTIFY_RETRY_MULTIPLIER=1.0
SPOTIFY_RETRY_MAX=10

YOUTUBE_RETRY_ATTEMPTS=3
YOUTUBE_RETRY_MULTIPLIER=1.0
YOUTUBE_RETRY_MAX=10

HTTP_RETRY_ATTEMPTS=3
HTTP_BACKOFF_FACTOR=1.0
HTTP_MIN_BACKOFF=1
HTTP_MAX_BACKOFF=10
